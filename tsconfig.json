{
    "compilerOptions": {
        "target": "es2016",
        "types": ["node", "jest"],
        "module": "commonjs",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "*": ["./types/*"]
        }
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules"]
}
