{
    "name": "sc-number-game-base",
    "version": "1.0.0-beta.34",
    "description": "The codebase of number games",
    "type": "module",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "files": [
        "dist/"
    ],
    "scripts": {
        "test": "jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "build": "tsc -p tsconfig.build.json",
        "reg": "npm set registry http://npm.lumigame.com",
        "pub": "npm publish --registry http://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm run build && npm publish --registry http://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/l1/sc-packages/sc-number-game-base.git"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "chance": "1.1.6",
        "crypto": "^1.0.1",
        "crypto-random-string": "^5.0.0",
        "d3-array": "3.2.0",
        "lodash": "^4.17.21",
        "nanoid": "^5.0.6",
        "random-js": "^2.1.0",
        "randomstring": "^1.3.0",
        "sc-common": "1.8.1",
        "sc-game-base": "5.0.1-beta.3",
        "socket.io-prom-metrics": "1.0.3"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.23.8",
        "@commitlint/cli": "^18.4.4",
        "@commitlint/config-conventional": "^18.4.4",
        "@types/chance": "^1.1.6",
        "@types/d3-array": "^3.2.1",
        "@types/jest": "^29.5.11",
        "@types/lodash": "^4.14.202",
        "@types/mongoose": "^5.11.97",
        "@types/randomstring": "^1.1.11",
        "husky": "^8.0.3",
        "jest": "^29.7.0",
        "jest-auto-stub": "^1.0.8",
        "jest-junit": "^16.0.0",
        "jest-sonar-reporter": "^2.0.0",
        "sc-semantic-release": "^1.3.0",
        "semantic-release": "^23.0.0",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
